<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TraiUsage.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="16,12,12,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                Margin="-8,0,0,0"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,0,4,0">
            <StackPanel Spacing="4">
                <!--  Settings card pattern without the Toolkit dependency  -->
                <Grid
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Keep the tray icon ready after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>

                <Grid
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Tray icon bars" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Pick the limits to draw, one bar each."
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="ClaudeBars" Margin="0,6,0,0">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Claude" />
                            <CheckBox x:Name="ClaudeSessionCheck" Content="Session" Tag="claude:session" Checked="BarCheck_Changed" Unchecked="BarCheck_Changed" />
                            <CheckBox x:Name="ClaudeWeeklyCheck" Content="Week" Tag="claude:weekly" Checked="BarCheck_Changed" Unchecked="BarCheck_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="CopilotBars" Margin="0,6,0,0">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="GitHub Copilot (monthly)" />
                            <CheckBox x:Name="CopilotPremiumCheck" Content="Premium requests" Tag="copilot:Premium requests" Checked="BarCheck_Changed" Unchecked="BarCheck_Changed" />
                            <CheckBox x:Name="CopilotChatCheck" Content="Chat" Tag="copilot:Chat" Checked="BarCheck_Changed" Unchecked="BarCheck_Changed" />
                            <CheckBox x:Name="CopilotCompletionsCheck" Content="Completions" Tag="copilot:Completions" Checked="BarCheck_Changed" Unchecked="BarCheck_Changed" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel
                    x:Name="ClaudeCard"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Spacing="2">
                    <TextBlock Text="Claude account" />
                    <TextBlock
                        x:Name="SignInText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SignInPathText"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="CopilotCard"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Spacing="2"
                    Visibility="Collapsed">
                    <TextBlock Text="GitHub Copilot account" />
                    <TextBlock
                        x:Name="CopilotSignInText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Margin="2,8,2,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Trai Usage reads the sign-ins that Claude Code and GitHub Copilot already have, to ask Claude and GitHub for your plan's limits, only while this flyout is open. It shows whichever you use, and never changes, renews, or copies a sign-in."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="VersionText"
                    Margin="2,8,2,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
