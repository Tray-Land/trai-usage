<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TraiUsage.Controls.UsageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="UsedFill.Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="CollapsedFill.Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="PaceText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="UsedFill.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="CollapsedFill.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="PaceText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Title, reset time, warning, and collapse control stay visible.  -->
            <Grid Padding="10,8,10,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="HeaderButton"
                    Grid.ColumnSpan="4"
                    Padding="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Collapse usage details"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="HeaderButton_Click" />
                <TextBlock
                    x:Name="TitleText"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="ResetText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <Button
                    x:Name="WarningButton"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Show usage warning"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Show usage warning"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel MaxWidth="280" Spacing="6">
                                <TextBlock
                                    x:Name="WarningTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="WarningMessage"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <FontIcon
                    x:Name="CollapseIcon"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Glyph="&#xE70E;"
                    IsHitTestVisible="False" />
            </Grid>

            <Grid
                x:Name="DetailsPanel"
                Grid.Row="1"
                Padding="14,0,14,12"
                ColumnSpacing="10"
                RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="34" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Used"
                    VerticalAlignment="Center" />
                <Grid
                    x:Name="UsedTrack"
                    Grid.Column="1"
                    Height="8"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                    CornerRadius="4"
                    SizeChanged="Track_SizeChanged">
                    <Border
                        x:Name="UsedFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4" />
                </Grid>
                <TextBlock
                    x:Name="UsedPercentText"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Time"
                    VerticalAlignment="Center" />
                <Grid
                    x:Name="TimeTrack"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                    CornerRadius="2"
                    SizeChanged="Track_SizeChanged">
                    <Border
                        x:Name="TimeFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                        CornerRadius="2" />
                </Grid>
                <TextBlock
                    x:Name="TimePercentText"
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,2,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TimeLeftText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PaceText"
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>

                <TextBlock
                    x:Name="OverageText"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Visibility="Collapsed" />
            </Grid>

            <Grid
                x:Name="CollapsedTrack"
                Grid.Row="2"
                Height="4"
                Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                SizeChanged="Track_SizeChanged"
                Visibility="Collapsed">
                <Border
                    x:Name="CollapsedFill"
                    Width="0"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Opacity="0.65" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
