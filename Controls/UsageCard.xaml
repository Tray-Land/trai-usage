<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TraiUsage.Controls.UsageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="14,12,14,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="UsedFill.Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="PaceText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="UsedFill.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="PaceText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnSpacing="10" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="34" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Title and reset time  -->
            <Grid Grid.ColumnSpan="3" Margin="0,0,0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="ResetText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <!--  How much of the limit is used  -->
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Used" />
            <Grid
                x:Name="UsedTrack"
                Grid.Row="1"
                Grid.Column="1"
                Height="8"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                CornerRadius="4"
                SizeChanged="Track_SizeChanged">
                <Border
                    x:Name="UsedFill"
                    Width="0"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="4" />
            </Grid>
            <TextBlock
                x:Name="UsedPercentText"
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <!--  How much of the window has passed  -->
            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Time" />
            <Grid
                x:Name="TimeTrack"
                Grid.Row="2"
                Grid.Column="1"
                Height="4"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                CornerRadius="2"
                SizeChanged="Track_SizeChanged">
                <Border
                    x:Name="TimeFill"
                    Width="0"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                    CornerRadius="2" />
            </Grid>
            <TextBlock
                x:Name="TimePercentText"
                Grid.Row="2"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!--  Countdown and pace  -->
            <Grid
                Grid.Row="3"
                Grid.ColumnSpan="3"
                Margin="0,2,0,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TimeLeftText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="PaceText"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <!--  Requests billed beyond the plan  -->
            <TextBlock
                x:Name="OverageText"
                Grid.Row="4"
                Grid.ColumnSpan="3"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
